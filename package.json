{
  "name": "crowdsource",
  "version": "0.1.0",
  "description": "CrowdSource \u2014 participatory moderation infrastructure: contracts, backend, reviewer app, console and SDKs",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:reviewer": "bun run --cwd packages/reviewer dev",
    "dev:console": "bun run --cwd packages/console dev",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build": "bun run build:contracts && bun run --cwd packages/backend build && bun run --cwd packages/sdk build && bun run --cwd packages/testing build && bun run --cwd packages/sdk-express build && bun run --cwd packages/app build",
    "build:contracts": "bun run --cwd packages/contracts build",
    "build:reviewer": "bun run --cwd packages/reviewer build",
    "build:console": "bun run --cwd packages/console build",
    "build:backend": "bun run build:contracts && bun run --cwd packages/backend build",
    "audit:security": "bun ./scripts/audit-security.mjs",
    "check:tests-typechecked": "bun ./.github/scripts/assert-tests-typechecked.mjs",
    "check:lockfile": "bun ./scripts/check-lockfile-sync.mjs",
    "check:app-postgres-only": "bun ./scripts/assert-app-postgres-only.mjs && bun ./scripts/test-assert-app-postgres-only.mjs && bun ./scripts/test-verify-cutover-manifest.mjs",
    "check:injection-sinks": "bun ./scripts/check-injection-sinks.mjs --min-files=200",
    "doctor": "bun ./scripts/doctor.mjs",
    "check": "bun run doctor && bun run validate:workflows && bun run validate:agents-md && bun run audit:security && bun run check:injection-sinks && bun run check:peers && bun run check:app-postgres-only && bun run build && bun run check:dist && bun run check:migrations && bun run check:schemas && bun run check:module-format && bun run --cwd packages/reviewer typecheck && bun run --cwd packages/console typecheck && bun run lint",
    "test": "bun run test:contracts && bun run test:backend && bun run test:sdk && bun run test:testing && bun run test:sdk-express && bun run test:app && bun run test:reviewer && bun run test:console",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:backend": "bun run --cwd packages/backend test",
    "test:sdk": "bun run --cwd packages/sdk test",
    "test:sdk-express": "bun run --cwd packages/sdk-express test",
    "test:app": "bun run --cwd packages/app test",
    "test:testing": "bun run --cwd packages/testing test",
    "test:reviewer": "bun run --cwd packages/reviewer test",
    "test:console": "bun run --cwd packages/console test",
    "validate:workflows": "bun ./scripts/validate-workflows.mjs",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "lint": "bun run lint:contracts && bun run lint:backend && bun run lint:sdk && bun run lint:sdk-express && bun run lint:testing && bun run lint:app && bun run lint:reviewer && bun run lint:console",
    "lint:contracts": "bun run --cwd packages/contracts lint",
    "lint:backend": "bun run --cwd packages/backend lint",
    "lint:sdk": "bun run --cwd packages/sdk lint",
    "lint:sdk-express": "bun run --cwd packages/sdk-express lint",
    "lint:testing": "bun run --cwd packages/testing lint",
    "lint:app": "bun run --cwd packages/app lint",
    "lint:reviewer": "bun run --cwd packages/reviewer lint",
    "lint:console": "bun run --cwd packages/console lint",
    "clean": "bun run clean:artifacts && bun run clean:deps",
    "clean:artifacts": "bun run --filter '*' clean && rm -f tsconfig.tsbuildinfo",
    "clean:deps": "rm -rf node_modules packages/*/node_modules",
    "install:all": "bun install",
    "start:reviewer": "bun run --cwd packages/reviewer start",
    "start:backend": "bun run --cwd packages/backend start",
    "postinstall": "bun run build:contracts",
    "check:peers": "bun ./scripts/check-peer-contracts.mjs && bun ./scripts/test-check-peer-contracts.mjs",
    "check:dist": "bun ./scripts/check-dist-orphans.mjs && bun ./scripts/test-check-dist-orphans.mjs",
    "check:schemas": "bun ./scripts/test-check-published-json-schemas.mjs && bun ./scripts/check-published-json-schemas.mjs",
    "check:module-format": "bun ./scripts/check-module-format.mjs && bun ./scripts/test-check-module-format.mjs",
    "check:migrations": "bun ./scripts/check-published-migrations.mjs && bun ./scripts/test-check-published-migrations.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "~5.9.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "56.0.4",
    "expo-file-system": "56.0.8",
    "expo-modules-core": "56.0.21",
    "react-native-svg": "15.15.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/metro-babel-transformer": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@oxyhq/bloom": "^1.8.0",
    "@oxyhq/core": "^23.0.0",
    "@oxyhq/services": "^30.2.0",
    "brace-expansion": "2.1.4",
    "socket.io-parser": "4.2.7",
    "fast-uri": "3.1.4",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.18",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "browserslist": "4.28.8"
  }
}
