{
  "name": "crowdsource",
  "version": "0.1.0",
  "description": "CrowdSource — participatory moderation infrastructure: contracts, backend, reviewer app, console and SDKs",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:reviewer": "bun run --cwd packages/reviewer dev",
    "dev:console": "bun run --cwd packages/console dev",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build": "bun run build:contracts && bun run --cwd packages/backend build && bun run --cwd packages/core build",
    "build:contracts": "bun run --cwd packages/contracts build",
    "build:reviewer": "bun run --cwd packages/reviewer build",
    "build:console": "bun run --cwd packages/console build",
    "build:backend": "bun run build:contracts && bun run --cwd packages/backend build",
    "audit:security": "bun ./scripts/test-zod-audit-paths.mjs && bun ./scripts/audit-security.mjs",
    "check:tests-typechecked": "bun ./.github/scripts/assert-tests-typechecked.mjs",
    "check:lockfile": "bun ./scripts/check-lockfile-sync.mjs",
    "check:injection-sinks": "bun ./scripts/check-injection-sinks.mjs --min-files=200",
    "doctor": "bun ./scripts/doctor.mjs",
    "doctor:oxy": "oxy-doctor --ci",
    "check": "bun run doctor && bun run validate:workflows && bun run validate:agents-md && bun run audit:security && bun run check:injection-sinks && bun run check:peers && bun run build && bun run check:dist && bun run check:migrations && bun run check:schemas && bun run check:module-format && bun run --cwd packages/reviewer typecheck && bun run --cwd packages/console typecheck && bun run lint",
    "test": "bun run test:contracts && bun run test:backend && bun run test:core && bun run test:reviewer && bun run test:console",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:backend": "bun run --cwd packages/backend test",
    "test:core": "bun run --cwd packages/core test",
    "test:reviewer": "bun run --cwd packages/reviewer test",
    "test:console": "bun run --cwd packages/console test",
    "validate:workflows": "bun ./scripts/validate-workflows.mjs",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "lint": "biome check . && bun run lint:contracts && bun run lint:backend && bun run lint:core && bun run lint:reviewer && bun run lint:console",
    "lint:contracts": "bun run --cwd packages/contracts lint",
    "lint:backend": "bun run --cwd packages/backend lint",
    "lint:core": "bun run --cwd packages/core lint",
    "lint:reviewer": "bun run --cwd packages/reviewer lint",
    "lint:console": "bun run --cwd packages/console lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "bun run clean:artifacts && bun run clean:deps",
    "clean:artifacts": "bun run --filter '*' clean && rm -f tsconfig.tsbuildinfo",
    "clean:deps": "rm -rf node_modules packages/*/node_modules",
    "install:all": "bun install",
    "start:reviewer": "bun run --cwd packages/reviewer start",
    "start:backend": "bun run --cwd packages/backend start",
    "postinstall": "bun run build:contracts",
    "check:peers": "bun ./scripts/check-peer-contracts.mjs && bun ./scripts/test-check-peer-contracts.mjs",
    "check:dist": "bun ./scripts/check-dist-orphans.mjs && bun ./scripts/test-check-dist-orphans.mjs",
    "check:schemas": "bun ./scripts/test-check-published-json-schemas.mjs && bun ./scripts/check-published-json-schemas.mjs",
    "check:module-format": "bun ./scripts/check-module-format.mjs && bun ./scripts/test-check-module-format.mjs",
    "check:migrations": "bun ./scripts/check-published-migrations.mjs && bun ./scripts/test-check-published-migrations.mjs",
    "test:worker": "bun test scripts/frontend-worker.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.3.0",
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@oxy.so/contracts": "6.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "expo-file-system": "58.0.10",
    "expo-modules-core": "58.0.23",
    "react-native-svg": "15.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "@oxy.so/bloom": "15.10.1",
    "@oxy.so/core": "7.1.0",
    "@oxy.so/services": "13.0.0",
    "brace-expansion": "2.1.7",
    "http-cache-semantics": "4.3.0",
    "socket.io-parser": "4.2.7",
    "fast-uri": "3.1.4",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.2",
    "linkify-it": "5.0.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.18",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "browserslist": "4.28.8",
    "@oxy.so/protocol": "1.5.1",
    "compression": "1.8.2",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "react-native-css": "3.1.0-rc.0",
    "body-parser": "2.4.0"
  }
}
