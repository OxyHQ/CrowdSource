{
  "name": "crowdsource",
  "version": "0.1.0",
  "description": "CrowdSource — participatory moderation infrastructure: contracts, backend, reviewer app, console and SDKs",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:reviewer": "bun run --cwd packages/reviewer dev",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build": "bun run build:contracts && bun run --cwd packages/backend build && bun run --cwd packages/sdk build && bun run --cwd packages/sdk-express build && bun run --cwd packages/testing build",
    "build:contracts": "bun run --cwd packages/contracts build",
    "build:reviewer": "bun run --cwd packages/reviewer build",
    "build:backend": "bun run build:contracts && bun run --cwd packages/backend build",
    "audit:security": "bun ./scripts/audit-security.mjs",
    "doctor": "bun ./scripts/doctor.mjs",
    "check": "bun run doctor && bun run validate:workflows && bun run audit:security && bun run build && bun run --cwd packages/reviewer typecheck && bun run lint",
    "test": "bun run test:contracts && bun run test:backend && bun run test:reviewer",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:backend": "bun run --cwd packages/backend test",
    "test:reviewer": "bun run --cwd packages/reviewer test",
    "validate:workflows": "bun ./scripts/validate-workflows.mjs",
    "lint": "bun run lint:contracts && bun run lint:backend && bun run lint:sdk && bun run lint:sdk-express && bun run lint:testing && bun run lint:reviewer",
    "lint:contracts": "bun run --cwd packages/contracts lint",
    "lint:backend": "bun run --cwd packages/backend lint",
    "lint:sdk": "bun run --cwd packages/sdk lint",
    "lint:sdk-express": "bun run --cwd packages/sdk-express lint",
    "lint:testing": "bun run --cwd packages/testing lint",
    "lint:reviewer": "bun run --cwd packages/reviewer lint",
    "clean": "bun run clean:artifacts && bun run clean:deps",
    "clean:artifacts": "bun run --filter '*' clean",
    "clean:deps": "rm -rf node_modules packages/*/node_modules",
    "install:all": "bun install",
    "start:reviewer": "bun run --cwd packages/reviewer start",
    "start:backend": "bun run --cwd packages/backend start",
    "postinstall": "bun run build:contracts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "~5.9.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "56.0.4",
    "expo-file-system": "56.0.8",
    "expo-modules-core": "56.0.21",
    "react-native-svg": "15.15.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/metro-babel-transformer": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@oxyhq/bloom": "^0.54.1",
    "@oxyhq/core": "^12.10.6",
    "@oxyhq/services": "^22.12.5",
    "brace-expansion": "2.1.2",
    "fast-uri": "3.1.4",
    "fast-xml-parser": "5.10.1",
    "linkify-it": "5.0.2",
    "postcss": "8.5.18",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1"
  }
}
