node_modules
dist
.expo
.git
.github
*.md
infrastructure/
package-lock.json
**/coverage/
**/*.tsbuildinfo
**/.claude/

# Never send local secrets or platform credentials to a Docker builder. Keep
# examples available to developers without allowing their populated variants
# into image layers or remote build caches.
**/.env*
!**/.env.example
**/.npmrc
**/.aws/
**/.ssh/
**/credentials/
**/*credentials*.json
**/*service-account*.json
**/google-services.json
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore

# The backend image never contains the client or SDK workspaces. Keep only the
# manifests needed to validate the full workspace lockfile — Bun's workspace
# filters exclude their dependency graphs, and the runtime stage deletes the
# directories outright.
packages/reviewer/*
!packages/reviewer/package.json
packages/console/*
!packages/console/package.json
packages/sdk/*
!packages/sdk/package.json
packages/sdk-express/*
!packages/sdk-express/package.json
packages/testing/*
!packages/testing/package.json

# Local-only planning notes. Untracked, so .gitignore does not keep them out of
# a build context.
.plan/
