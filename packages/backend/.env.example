# CrowdSource backend runtime configuration
#
# Copy this file to `.env` for local development. In AWS, secret values live in
# SSM SecureString parameters and are injected by the ECS task definition.
# Blank optional values are treated as absent; malformed supplied values fail
# fast in `src/config/index.ts`.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Required PostgreSQL application-role connection. The role must own no tables
# and must be subject to forced RLS; never put the migrator or an admin URL here.
# Provision the two-role topology and schema before starting the backend. See
# `docs/runbooks/crowdsource-backend-postgres-cutover.md` for the exact contract.
DATABASE_URL=

# Optional service integrations. Blank values are treated as absent.
WEBHOOK_SECRET_ENCRYPTION_KEY=
OXY_API_URL=

# PostgreSQL-backed reviewer and sortition controls.
REVIEWER_MIN_PERSONHOOD_CONFIDENCE=0.5
SORTITION_CANDIDATE_SAMPLE_SIZE=400
