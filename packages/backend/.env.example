# CrowdSource backend runtime configuration
#
# Copy this file to `.env` for local development. In AWS, secret values live in
# SSM SecureString parameters and are injected by the ECS task definition.
# Blank optional values are treated as absent; malformed supplied values fail
# fast in `src/config/index.ts`.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# MongoDB. Point this at the replica-set instance you already run for the other
# Oxy apps; CrowdSource uses its own database inside it.
#
# The DATABASE COMPONENT of this URI is IGNORED. The database is
# `crowdsource-<NODE_ENV>`, composed in `src/config/databaseIdentity.ts` and
# passed to Mongoose as `dbName`, which overrides whatever the URI names. Point
# this at a host, not at a database.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Mongo tuning (optional; the defaults below are what the code applies)
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=20000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# MONGODB_MAX_RETRIES=5
