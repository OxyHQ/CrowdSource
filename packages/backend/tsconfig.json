{
  // ---------------------------------------------------------------------------
  // @crowdsource/backend
  //
  // Compiled with `tsc` to `dist/` (CommonJS) and THAT emitted output is what
  // the Docker/ECS image runs. The module format and emit layout below are a
  // runtime contract — changing them changes what ships to production.
  //
  // Everything else inherits from the root base; we override only the bits that
  // make this an emitting CommonJS Node service rather than the type-check-only
  // base.
  // ---------------------------------------------------------------------------
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "types": ["node"],
    // --- Intentional override of the root base: emit CommonJS for Node/Bun.
    // The ECS image executes the emitted `dist/**` as CommonJS.
    // Node16, not `commonjs` + `node` (node10): TypeScript 7, which `bun check`
    // implements, removes node10 (TS5108), and TypeScript 5.x rejects `bundler`
    // with `commonjs` (TS5095), so Node16 is the one setting both accept. With
    // `"type": "commonjs"` in package.json and no dynamic `import()` in the
    // emitted sources, Node16 emits the same CommonJS byte for byte; imports
    // now resolve through each dependency's `exports` map, as Node does.
    "module": "node16",
    "moduleResolution": "node16",

    // --- Emit settings (the root base is type-check only / noEmit).
    // `rootDir: "./"` because the entrypoint `server.ts` lives at the package
    // root (not under src/); TypeScript auto-excludes `outDir` (dist) from the
    // compilation, so the emitted production tree mirrors the non-test source
    // tree under dist/. Tests remain source-only and run directly in Vitest.
    //
    // That mirroring is a runtime contract for `scripts/` too, and not only for
    // `server.ts`: `.github/scripts/deploy-ecs-image.sh` runs the migration
    // one-shot as `packages/backend/dist/scripts/migrate.js`, which exists only
    // because `scripts/migrate.ts` sits one level below this rootDir.
    "noEmit": false,
    "rootDir": "./",
    "outDir": "dist",
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Resolve the workspace dependency to contracts SOURCE during type-check so
    // backend changes see un-built type updates immediately.
    "paths": {
      "@crowdsource.you/contracts": ["../contracts/src"],
      "@crowdsource.you/contracts/*": ["../contracts/src/*"]
    }
  },
  // `scripts/**` is compiled, not just type-checked: the migration entrypoint
  // ships in the image. Omit it and `tsc` succeeds, the image builds, and the
  // deploy's migration task fails at run time with "module not found" — after
  // the image has been pushed.
  "include": ["server.ts", "scripts/**/*.ts", "src/**/*.ts", "package.json"],
  "exclude": ["dist", "src/__tests__", "**/*.test.ts", "**/*.spec.ts"],
  "references": [{ "path": "../contracts" }]
}
