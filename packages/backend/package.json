{
  "name": "@crowdsource/backend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@oxy.so/core": "^1.18.0",
    "@crowdsource.you/contracts": "workspace:*",
    "@oxy.so/db": "^1.0.0",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
