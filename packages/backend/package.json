{
  "name": "@crowdsource/backend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc",
    "lint": "bun check && bun check -p tsconfig.test.json",
    "test": "bun --no-env-file ./run-tests.ts ./src/__tests__",
    "test:watch": "bun --no-env-file ./run-tests.ts --watch ./src/__tests__",
    "test:coverage": "bun --no-env-file ./run-tests.ts --coverage ./src/__tests__",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@oxy.so/core": "7.0.0",
    "@crowdsource.you/contracts": "workspace:*",
    "@oxy.so/db": "^1.3.0",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7",
    "@aws-sdk/credential-provider-node": "3.972.88"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/supertest": "^7.2.1",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3"
  }
}
