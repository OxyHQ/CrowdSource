{
  "name": "@crowdsource/backend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "db:generate": "drizzle-kit generate",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@oxyhq/core": "^12.11.0",
    "@oxyhq/crowdsource-contracts": "workspace:*",
    "@oxyhq/db": "^0.1.2",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
