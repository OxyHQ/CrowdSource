{
  "name": "@oxyhq/crowdsource",
  "version": "0.4.0",
  "description": "TypeScript client for the CrowdSource moderation API: reports, uploads, cases and decisions",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && bun ../../scripts/write-esm-marker.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.test.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "crowdsource",
    "moderation",
    "sdk"
  ],
  "author": "OxyHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OxyHQ/CrowdSource",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/OxyHQ/CrowdSource/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/OxyHQ/CrowdSource/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxyhq/crowdsource-contracts": "workspace:*",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/__tests__/**"
  ],
  "peerDependencies": {
    "@oxyhq/crowdsource-contracts": "^0.4.0"
  }
}
