{
  "name": "@oxyhq/crowdsource-testing",
  "version": "0.1.0",
  "description": "Fixtures, a webhook simulator and a sandbox harness for integrating with CrowdSource",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["crowdsource", "moderation", "fixtures", "testing"],
  "author": "OxyHQ",
  "license": "MIT",
  "dependencies": {
    "@oxyhq/crowdsource-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  },
  "files": ["dist/**/*"]
}
