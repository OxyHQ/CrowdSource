{
  "name": "@oxyhq/crowdsource-testing",
  "version": "0.1.0",
  "description": "Fixtures, a webhook simulator and a sandbox harness for integrating with CrowdSource",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.test.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["crowdsource", "moderation", "fixtures", "testing"],
  "author": "OxyHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OxyHQ/CrowdSource",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/OxyHQ/CrowdSource/tree/main/packages/testing#readme",
  "bugs": "https://github.com/OxyHQ/CrowdSource/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oxyhq/crowdsource-contracts": "workspace:*"
  },
  "devDependencies": {
    "@oxyhq/crowdsource": "workspace:*",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "files": ["dist/**/*", "src/**/*", "!src/**/__tests__/**"]
}
