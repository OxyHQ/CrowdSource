# CrowdSource console configuration
#
# Copy to `.env` for local development. Only EXPO_PUBLIC_* variables reach the
# client bundle; never put a secret in this file.

# Backend origin. Defaults to http://localhost:3000 outside production.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Oxy identity API. Defaults to http://localhost:3001 outside production.
EXPO_PUBLIC_OXY_BASE_URL=http://localhost:3001

# CrowdSource's registered Oxy OAuth client id. REQUIRED for interactive
# sign-in: there is no fallback in source, because hard-coding one would borrow
# another product's identity. The console shares the reviewer app's client id;
# this origin must also be registered as a redirect URI on it.
EXPO_PUBLIC_OXY_CLIENT_ID=

# Registered OAuth redirect surface for this origin (exact match).
# EXPO_PUBLIC_OXY_AUTH_REDIRECT_URI=http://localhost:8081

# Public origin of this deployment.
# EXPO_PUBLIC_WEB_BASE_URL=http://localhost:8081

# Client log level: debug | info | log | warn | error
# EXPO_PUBLIC_LOG_LEVEL=debug
