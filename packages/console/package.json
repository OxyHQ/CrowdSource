{
  "name": "@crowdsource/console",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "description": "CrowdSource developer and Trust & Safety console",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "expo start --web --clear",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "test": "node ../../node_modules/jest/bin/jest.js --watchAll=false --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "clean": "rm -rf dist .expo"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@oxyhq/services/ui/client$": "<rootDir>/../../node_modules/@oxyhq/services/lib/commonjs/ui/client.js"
    },
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.test.{ts,tsx}",
      "!**/*.d.ts",
      "!dist/**",
      "!.expo/**",
      "!node_modules/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "eslint-config-expo"
      ]
    }
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@expo/vector-icons": "^15.1.1",
    "@oxyhq/bloom": "^0.85.0",
    "@oxyhq/core": "^13.0.0",
    "@oxyhq/crowdsource-contracts": "workspace:*",
    "@oxyhq/services": "^23.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.101.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "clsx": "^2.1.1",
    "expo": "~56.0.16",
    "expo-asset": "~56.0.20",
    "expo-constants": "~56.0.21",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.8",
    "expo-image-picker": "~56.0.21",
    "expo-linking": "~56.0.15",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "i18next": "^26.3.6",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-preview.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.9",
    "react-native": "0.85.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "^56.0.5",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "@unrs/resolver-binding-linux-x64-gnu": "^1.12.2",
    "lightningcss-linux-x64-gnu": "1.30.1"
  }
}
