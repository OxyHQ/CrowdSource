{
  "name": "@crowdsource/console",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "description": "CrowdSource developer and Trust & Safety console",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "expo start --web --clear",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "test": "node ../../node_modules/jest/bin/jest.js --watchAll=false --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint .",
    "clean": "rm -rf dist .expo"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@oxy.so/services/ui/client$": "<rootDir>/../../node_modules/@oxy.so/services/lib/commonjs/ui/client.js"
    },
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.test.{ts,tsx}",
      "!**/*.d.ts",
      "!dist/**",
      "!.expo/**",
      "!node_modules/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@alia.onl/sdk": "^15.2.1",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@crowdsource.you/contracts": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@oxy.so/bloom": "10.6.0",
    "@oxy.so/core": "4.8.0",
    "@oxy.so/services": "11.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "clsx": "^2.1.1",
    "expo": "~57.0.29",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.3",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.13",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-plugin-expo": "^1.0.3",
    "jest": "~30.5.2",
    "jest-expo": "^56.0.5",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "@unrs/resolver-binding-linux-x64-gnu": "^1.12.2",
    "lightningcss-linux-x64-gnu": "1.30.1"
  }
}
