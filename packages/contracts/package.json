{
  "name": "@crowdsource.you/contracts",
  "version": "1.1.1",
  "description": "Versioned CrowdSource contracts: case envelope, resources, taxonomy, policies, reviews, decisions, webhooks and reputation events",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && bun ../../scripts/write-esm-marker.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "bun check --noUnusedLocals --noUnusedParameters && bun check -p tsconfig.test.json",
    "test": "bun test ./src/__tests__",
    "test:watch": "bun test --watch ./src/__tests__",
    "prepublishOnly": "bun run test && bun run build"
  },
  "keywords": [
    "crowdsource",
    "moderation",
    "contracts",
    "typescript"
  ],
  "author": "OxyHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OxyHQ/CrowdSource",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/OxyHQ/CrowdSource/tree/main/packages/contracts#readme",
  "bugs": "https://github.com/OxyHQ/CrowdSource/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/__tests__/**"
  ]
}
