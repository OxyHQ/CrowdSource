{
  // ---------------------------------------------------------------------------
  // Type-check-only project covering everything the emitting project leaves out:
  // the contract tests, which `bun test` runs from source.
  //
  // It exists because tests must not be emitted into `dist/` (they would ship in
  // the published tarball) but must still be type-checked — a contract test that
  // does not compile is a contract test nobody is running. `bun run lint` runs
  // this project after the emitting one.
  //
  // `composite` and the declaration outputs are off: nothing references this
  // project, and a composite project may not disable emit.
  // ---------------------------------------------------------------------------
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // `bun-types` for the `bun:test` module the tests import. A direct
    // dependency on `bun-types` rather than `@types/bun`, deliberately: anything
    // under `node_modules/@types` is hoisted to the root and joins EVERY project
    // that does not list its `types`, which put Bun's `fetch` into `core`'s
    // published source and failed its build.
    "types": ["node", "bun-types"],
    // The tests never reach a consumer bundle, so they may use ES2022 built-ins
    // (`Object.hasOwn`). The emitting project keeps the root lib.
    "lib": ["ES2022"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
