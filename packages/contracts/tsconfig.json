{
  // ---------------------------------------------------------------------------
  // @crowdsource.you/contracts
  //
  // The versioned contracts every CrowdSource surface agrees on: the backend
  // (Node/Bun, CommonJS), the reviewer and console clients (Metro/Expo bundler),
  // the published SDKs, and third-party integrators. It is the only emitting
  // leaf all of those consume at the same time, so its output must be safe for
  // each.
  //
  // It emits CommonJS to `dist/` (with .d.ts declarations) because the backend
  // imports it as a compiled CJS dependency and runs that emitted output in the
  // Docker/ECS image. Metro happily consumes the same CJS + declarations, so a
  // single CJS build serves both. Everything else inherits from the root base.
  // ---------------------------------------------------------------------------
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // --- Intentional override of the root base: emit CommonJS for the backend.
    // Node16, not `commonjs` + `node` (node10): TypeScript 7, which `bun check`
    // implements, removes node10 (TS5108), and TypeScript 5.x rejects `bundler`
    // with `commonjs` (TS5095), so Node16 is the one setting both accept. With
    // `"type": "commonjs"` in package.json and no dynamic `import()` in the
    // emitted sources, Node16 emits the same CommonJS byte for byte; imports
    // now resolve through each dependency's `exports` map, as Node does.
    "module": "node16",
    "moduleResolution": "node16",
    // Stated rather than left to tsc's default of every `node_modules/@types`
    // package (React, Jest and jsdom's DOM among them), which `bun check` does
    // not load: the two checkers then see the same program. The contracts are
    // runtime-neutral and need no ambient types.
    "types": [],

    // --- Emit settings (the root base is type-check only / noEmit).
    "noEmit": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  // Tests are excluded from the EMITTING project so they never reach `dist/`
  // and therefore never reach the published tarball. They are still fully
  // type-checked — `tsconfig.test.json` covers them and `bun run lint` runs
  // both projects, so excluding them here costs no coverage.
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
