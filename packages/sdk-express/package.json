{
  "name": "@oxyhq/crowdsource-express",
  "version": "0.3.0",
  "description": "Express middleware for CrowdSource webhooks: raw body capture, HMAC verification, replay protection and typed events",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.test.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "crowdsource",
    "moderation",
    "webhooks",
    "express"
  ],
  "author": "OxyHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OxyHQ/CrowdSource",
    "directory": "packages/sdk-express"
  },
  "homepage": "https://github.com/OxyHQ/CrowdSource/tree/main/packages/sdk-express#readme",
  "bugs": "https://github.com/OxyHQ/CrowdSource/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@oxyhq/crowdsource-contracts": "^0.3.0",
    "express": ">=4"
  },
  "devDependencies": {
    "@oxyhq/crowdsource": "workspace:*",
    "@oxyhq/crowdsource-contracts": "workspace:*",
    "@oxyhq/crowdsource-testing": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "express": "^5.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/__tests__/**"
  ]
}
