{
  "name": "@oxy.so/crowdsource-app",
  "version": "1.0.0",
  "description": "The application half of a CrowdSource integration: a transactional outbox, delivery, a webhook receiver, decision application and idempotent enforcement, wired to your own subjects",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/esm/postgres/index.js",
      "require": "./dist/postgres/index.js",
      "default": "./dist/postgres/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && bun ../../scripts/write-esm-marker.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.test.json",
    "prepublishOnly": "bun run build",
    "test": "bun run test:unit && bun run test:invariants && bun run test:table-type",
    "test:invariants": "bun ./scripts/test-invariants.mjs",
    "test:table-type": "bun ./scripts/test-report-table-type.mjs",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs"
  },
  "keywords": [
    "crowdsource",
    "moderation",
    "outbox",
    "webhooks",
    "express",
    "postgresql"
  ],
  "author": "OxyHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OxyHQ/CrowdSource",
    "directory": "packages/app"
  },
  "homepage": "https://github.com/OxyHQ/CrowdSource/tree/main/packages/app#readme",
  "bugs": "https://github.com/OxyHQ/CrowdSource/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oxy.so/crowdsource": "workspace:*",
    "@oxy.so/crowdsource-express": "workspace:*"
  },
  "devDependencies": {
    "@oxy.so/crowdsource-contracts": "workspace:*",
    "@oxy.so/crowdsource-testing": "workspace:*",
    "@oxy.so/db": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/__tests__/**"
  ],
  "peerDependencies": {
    "@oxy.so/crowdsource-contracts": "^1.0.0",
    "@oxy.so/db": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "express": ">=4.18.0 <6",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "@oxy.so/db": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  }
}
